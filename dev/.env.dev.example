# Copy to the repo root as .env.dev (gitignored) and fill in from your DEV Supabase project.
# Project Settings -> Database -> Connection string (URI, "Session pooler" works on IPv4 networks)
DEV_DB_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# Project Settings -> API
DEV_SUPABASE_URL=https://xxxxxxxx.supabase.co
DEV_ANON_KEY=eyJ...
DEV_SERVICE_ROLE_KEY=eyJ...
# Password given to all seeded test accounts
DEV_USER_PASSWORD=change-me-dev-only
